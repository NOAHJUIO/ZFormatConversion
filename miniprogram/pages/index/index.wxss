.page { padding: 32rpx 28rpx 180rpx; min-height: 100vh; box-sizing: border-box; }

.header { padding: 40rpx 0 36rpx; }
.logo { font-size: 52rpx; font-weight: 700; letter-spacing: -1.5rpx; display: block; }

.section { margin-bottom: 32rpx; }
.section-title {
  font-size: 22rpx; font-weight: 600; color: var(--text-secondary);
  text-transform: uppercase; letter-spacing: 1.5rpx;
  margin-bottom: 16rpx; padding-left: 2rpx; display: block;
}

.grid { display: flex; flex-wrap: wrap; gap: 12rpx; }

/* ---------- Card ---------- */
.card {
  width: calc(50% - 6rpx);
  background: var(--card);
  border: 0.5rpx solid var(--border);
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
              border-color 0.25s ease,
              background 0.25s ease;
}
.card:active { transform: scale(0.96); background: var(--card-hover); }
.card--active {
  border-color: rgba(10, 132, 255, 0.5);
  background: rgba(10, 132, 255, 0.08);
}
.card--pop {
  animation: cardPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes cardPop {
  0% { transform: scale(1); }
  40% { transform: scale(1.04); }
  100% { transform: scale(1); }
}

.card-badge {
  width: 40rpx; height: 40rpx; border-radius: 10rpx;
  background: rgba(255,255,255,0.06);
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 700; color: var(--text-secondary);
  margin-bottom: 10rpx;
  transition: all 0.25s ease;
}
.card-badge--img { font-size: 26rpx; }
.card--active .card-badge { background: var(--accent-dim); color: var(--accent); }

.card-from, .card-to {
  font-size: 28rpx; font-weight: 600; display: block; line-height: 1.2;
}
.card-from { color: var(--text); }
.card-to { color: var(--accent); margin-top: 2rpx; }

.card-arrow {
  margin: 6rpx 0;
  height: 2rpx;
  background: rgba(255,255,255,0.1);
  position: relative;
}
.card-arrow-icon {
  display: none;
}

.card-check {
  position: absolute;
  top: 10rpx; right: 12rpx;
  width: 32rpx; height: 32rpx; border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 20rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  animation: checkIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes checkIn {
  0% { transform: scale(0); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

/* ---------- Upload ---------- */
.upload-wrap {
  margin-top: 8rpx;
  opacity: 0; transform: translateY(12rpx);
  transition: all 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
  pointer-events: none;
}
.upload-wrap--show { opacity: 1; transform: translateY(0); pointer-events: auto; }

.upload-tap {
  background: var(--card);
  border: 0.5rpx dashed rgba(255,255,255,0.1);
  border-radius: 16rpx;
  padding: 28rpx;
  display: flex; align-items: center; justify-content: center;
  gap: 16rpx;
  transition: background 0.15s ease;
}
.upload-tap:active { background: var(--card-hover); }
.upload-ring {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  border: 1.5rpx solid rgba(255,255,255,0.15);
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 200; color: var(--text-secondary);
}
.upload-text { font-size: 26rpx; color: var(--text-secondary); font-weight: 500; }

/* File chip */
.file-chip {
  background: rgba(10,132,255,0.1);
  border: 0.5rpx solid rgba(10,132,255,0.3);
  border-radius: 16rpx;
  padding: 20rpx 20rpx 20rpx 24rpx;
  display: flex; align-items: center; gap: 12rpx;
  animation: chipIn 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}
@keyframes chipIn {
  0% { opacity: 0; transform: scale(0.95); }
  100% { opacity: 1; transform: scale(1); }
}
.file-chip-name {
  flex: 1; font-size: 26rpx; font-weight: 500;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.file-chip-size { font-size: 22rpx; color: var(--text-secondary); }
.file-chip-x {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: rgba(255,255,255,0.06);
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: var(--text-secondary);
}

/* ---------- Convert Button ---------- */
.convert-btn {
  position: fixed; bottom: 44rpx; left: 28rpx; right: 28rpx;
  height: 88rpx; line-height: 88rpx; padding: 0;
  background: var(--card); color: var(--text-secondary);
  border: 0.5rpx solid var(--border); border-radius: 18rpx;
  font-size: 28rpx; font-weight: 600; letter-spacing: 0.3rpx;
  transition: all 0.35s ease;
}
.convert-btn[disabled] { opacity: 0.45; }
.convert-btn--live {
  background: var(--accent); color: #fff; border-color: var(--accent);
  animation: btnGlow 2s ease-in-out infinite;
}
.convert-btn--live:active { transform: scale(0.97); opacity: 0.85; }
.convert-btn--busy { animation: btnBusy 0.8s ease-in-out infinite; }

@keyframes btnGlow {
  0%, 100% { box-shadow: none; }
  50% { box-shadow: 0 0 32rpx rgba(10,132,255,0.25); }
}
@keyframes btnBusy {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}
