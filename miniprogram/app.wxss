page {
  --bg: #000000;
  --card: #1C1C1E;
  --card-hover: #2C2C2E;
  --text: #FFFFFF;
  --text-secondary: #8E8E93;
  --accent: #0A84FF;
  --accent-dim: rgba(10, 132, 255, 0.15);
  --border: rgba(255, 255, 255, 0.08);
  --green: #30D158;

  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}
